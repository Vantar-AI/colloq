FROM rust:1.96-bookworm AS build
WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY src ./src
RUN cargo build --release --locked

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/*
COPY --from=build /src/target/release/eve /bin/eve
COPY examples/generate.eveconv.json /etc/eve/conversation.json
COPY examples/draft-sync.eveconv.json /etc/eve/draft-sync.eveconv.json
USER 65532:65532
